rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Un solo laboratorio condiviso: chiunque abbia effettuato l'accesso
    // (stesse credenziali per tutto il team) legge e scrive tutti i dati.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
